# ============================================================================
# 1. LangChain LLM Evaluator Configuration (Local Ollama Default)
# ============================================================================
# Options: ollama (default, 100% local & free) | gemini
LLM_PROVIDER=ollama

# Local Ollama model name (any model from `ollama list`, e.g. qwen2.5-coder:7b, llama3.1:8b, gemma3)
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
# Expanded context window so file trees + README + git diffs never get silently truncated:
OLLAMA_NUM_CTX=16384
LLM_TEMPERATURE=0.2

# --- Optional: Switch to Google Gemini API (Google AI Studio API Key) ---
# Note: Consumer Gemini Pro/Advanced web subscriptions do not issue API keys directly,
# but you can grab a free-tier API key anytime at https://aistudio.google.com/apikey
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy-replace-me
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# 2. GitHub & React Portfolio Repository Sync
# ============================================================================
# GitHub Personal Access Token (`Contents: Read` on watched repos;
# `Contents: Read and write` on your React portfolio repo):
GITHUB_PAT=github_pat_replace_me

# HTTPS URL of your standalone React portfolio repository:
PORTFOLIO_REPO_URL=https://github.com/manojkumar2291/your-portfolio-repo.git

# Path to your projects catalog inside the portfolio repo (auto-discovered if omitted).
# Supports ES modules (`export const projects = [...]` in .js/.ts) AND `.json` files:
PORTFOLIO_PROJECTS_PATH=src/data/projects.js
PORTFOLIO_BRANCH=main

GIT_AUTHOR_NAME=career-sync-hub[bot]
GIT_AUTHOR_EMAIL=career-sync-hub@users.noreply.github.com

# ============================================================================
# 3. Webhook Security & Desktop CLI Sync
# ============================================================================
WEBHOOK_SECRET=generate-a-strong-random-32-char-secret
HUB_SERVER_URL=http://localhost:8000
