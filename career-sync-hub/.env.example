# ============================================================================
# 1. LangChain LLM Evaluator Configuration (Local Ollama Default)
# ============================================================================
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_NUM_CTX=4096
LLM_TEMPERATURE=0.2

# --- Optional: Google Gemini API (Google AI Studio API Key) ---
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=AIzaSy-replace-me
# GEMINI_MODEL=gemini-2.5-flash

# ============================================================================
# 2. GitHub & React Portfolio Repository Sync
# ============================================================================
GITHUB_PAT=github_pat_replace_me
PORTFOLIO_REPO_URL=https://github.com/manojkumar2291/your-portfolio-repo.git
PORTFOLIO_PROJECTS_PATH=src/data/projects.js
PORTFOLIO_BRANCH=main

GIT_AUTHOR_NAME=career-sync-hub[bot]
GIT_AUTHOR_EMAIL=career-sync-hub@users.noreply.github.com

# ============================================================================
# 3. Official LinkedIn API (Hands-Free Launch Post Publishing)
# ============================================================================
# Generate in 2 minutes at https://www.linkedin.com/developers/apps -> Auth -> OAuth 2.0 tools:
# Enable Products: "Share on LinkedIn" + "Sign In with LinkedIn using OpenID Connect"
# Scopes: openid, profile, w_member_social
LINKEDIN_ACCESS_TOKEN=
# Optional: auto-fetched via /v2/userinfo if left blank!
LINKEDIN_PERSON_URN=
# PUBLIC (default) or CONNECTIONS
LINKEDIN_VISIBILITY=PUBLIC

# ============================================================================
# 4. API Security & Local Hub URL
# ============================================================================
WEBHOOK_SECRET=generate-a-strong-random-32-char-secret
HUB_SERVER_URL=http://localhost:8000
